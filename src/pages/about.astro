---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { brand } from '../lib/brand.js';
import { categories, products, forms, inCategory } from '../lib/catalogue.js';
import { bannerImage } from '../lib/banners.js';
import Standards from '../components/Standards.astro';

const heroPhoto = bannerImage('athlete-1');
const bannerPhoto = bannerImage('athlete-2');
const flavoured = products.filter((p) => p.flavours.length).length;

const pillars = [
  ['flask', 'Science first', 'Formulas built on the best science in Europe and the world, then refined until every serving earns its place.'],
  ['shield', 'Nothing hidden', 'Every dose and every ingredient is printed in full, on the pack and on every product page.'],
  ['layers', 'Made for athletes', 'For first-time lifters and elite bodybuilders alike: products that work as hard as you train.'],
];
const facts = [
  [products.length, 'Products'],
  [categories.length, 'Goal ranges'],
  [forms.length, 'Formats'],
  [flavoured, 'Flavoured formulas'],
];
---
<Base darkHero title="About" current="about" description={`Royal Nutrition: ${brand.tagline}. Built to make you stronger and remove limits. Based in Pustkow, Poland.`}>
  <div class="about">
    <section class="hero on-dark" data-hero>
      {heroPhoto && <img class="hero-photo" src={heroPhoto} alt="" fetchpriority="high" />}
      <div class="wrap hero-inner">
        <p class="kicker">About Royal Nutrition</p>
        <h1>Built to break limits.</h1>
        <p class="lead">Royal Nutrition makes European food supplements for athletes who refuse to stand still. Formulated with the best science in Europe and the world, and trusted by elite athletes and bodybuilders, every product exists to make you stronger and take your limits away.</p>
        <div class="actions">
          <a class="btn invert" href="/products/">Enter the range<Icon name="arrow" /></a>
          <a class="btn glass" href="/contact/">Contact us</a>
        </div>
      </div>
    </section>

    <section class="wrap block">
      <div class="head" data-fade>
        <h2>The Royal standard</h2>
        <p>Three promises behind every tub, bag and bottle.</p>
      </div>
      <ul class="pillars">
        {pillars.map(([icon, title, text]) => (
          <li data-fade>
            <span class="pillar-icon"><Icon name={icon} /></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </section>

    <Standards variant="full" />

    <section class="facts on-dark" aria-label="The range in numbers">
      <ul class="wrap fact-row">
        {facts.map(([n, label]) => (
          <li data-fade><p class="fact-n">{n}</p><p class="fact-l">{label}</p></li>
        ))}
      </ul>
    </section>

    <section class="wrap block">
      <div class="head" data-fade>
        <h2>One standard. Seven ranges.</h2>
        <p>Pick the goal you train for and go straight to the products built for it.</p>
      </div>
      <ul class="ranges">
        {categories.map((c, i) => {
          const items = inCategory(c.slug);
          return (
            <li data-fade>
              <a href={`/products/?goal=${c.slug}`}>
                <span class="r-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="r-name">{c.name}</span>
                <span class="r-blurb">{c.blurb}</span>
                <span class="r-count">{items.length} products<Icon name="arrow" /></span>
                <img src={items[0].images[0].thumb} alt="" width="96" height="96" loading="lazy" />
              </a>
            </li>
          );
        })}
        <li class="r-all" data-fade>
          <a href="/products/">
            <span class="r-name">Every product, one place</span>
            <span class="r-blurb">Search, filter and compare the full catalogue.</span>
            <span class="r-count">View all {products.length}<Icon name="arrow" /></span>
          </a>
        </li>
      </ul>
    </section>

    <section class="banner on-dark">
      {bannerPhoto && <img class="banner-photo" src={bannerPhoto} alt="" loading="lazy" />}
      <div class="wrap banner-inner">
        <h2>Train without limits.</h2>
        <p>Strength is built one rep at a time. The right formula makes every one of them count.</p>
        <a class="btn invert" href="/products/">Explore supplements<Icon name="arrow" /></a>
      </div>
    </section>

    <section class="band">
      <div class="wrap band-grid">
        <div data-fade>
          <h2>Where we work</h2>
          <address>
            {brand.address.map((line) => <span>{line}</span>)}
          </address>
        </div>
        <dl data-fade>
          <div><dt>Our focus</dt><dd>{brand.tagline}</dd></div>
          <div><dt>Questions</dt><dd><a href={`mailto:${brand.emails.info}`}>{brand.emails.info}</a></dd></div>
        </dl>
        <a class="btn" href="/contact/" data-fade>Contact us</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .about { overflow-x: clip; }
  h2 { font-size: clamp(30px, 4vw, 54px); font-weight: 600; }

  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: flex-end; min-height: min(86svh, 760px); background: var(--night); color: #fff; }
  .hero-photo { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 78% 18%; filter: grayscale(1) contrast(1.08); }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(10, 10, 10, .92) 0%, rgba(10, 10, 10, .62) 46%, rgba(10, 10, 10, .1) 100%), linear-gradient(0deg, rgba(10, 10, 10, .7) 0%, rgba(10, 10, 10, 0) 40%); }
  .hero-inner { width: 100%; padding-block: 150px clamp(48px, 7vw, 96px); }
  .kicker { font: 500 13px/1 var(--display); letter-spacing: .16em; text-transform: uppercase; color: var(--on-blue-muted); }
  .hero h1 { max-width: 12ch; margin-top: 20px; font-size: clamp(42px, 6.4vw, 100px); font-weight: 600; line-height: 1; }
  .lead { max-width: 52ch; margin-top: 24px; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.6; color: var(--on-blue-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  /* ---------- Pillars ---------- */
  .block { padding-block: clamp(64px, 8vw, 120px); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 40px; margin-bottom: clamp(28px, 4vw, 48px); }
  .head p { max-width: 44ch; font-size: 17px; color: var(--muted); }
  .pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .pillars li { padding: clamp(24px, 3vw, 40px); background: var(--ice); border-radius: 4px; transition: background-color .3s, translate .5s var(--ease-out); }
  .pillars li:hover { background: #e9e9e6; translate: 0 -4px; }
  .pillar-icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 48px; background: var(--ink); color: #fff; border-radius: 50%; }
  .pillar-icon :global(.icon) { width: 24px; height: 24px; }
  .pillars h3 { font-size: clamp(22px, 2vw, 28px); font-weight: 600; }
  .pillars p { margin-top: 12px; color: var(--muted); }

  /* ---------- Numbers ---------- */
  .facts { background: var(--night); color: #fff; }
  .fact-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .fact-row li { padding: clamp(32px, 4vw, 56px) 24px clamp(32px, 4vw, 56px) 0; }
  .fact-row li + li { padding-left: 24px; border-left: 1px solid rgba(255, 255, 255, .14); }
  .fact-n { font: 600 clamp(48px, 6vw, 88px)/1 var(--display); font-variant-numeric: tabular-nums; }
  .fact-l { margin-top: 8px; color: var(--on-blue-muted); }

  /* ---------- Ranges ---------- */
  .ranges { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ranges a { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr) 96px; grid-template-rows: auto auto auto; column-gap: 16px; align-items: center; min-height: 148px; padding: 24px; background: var(--ice); border-radius: 4px; text-decoration: none; transition: background-color .3s, color .3s; }
  .r-n { grid-row: 1 / 4; align-self: start; font: 500 14px/1.6 var(--display); color: var(--muted); font-variant-numeric: tabular-nums; }
  .r-name { grid-column: 2; font: 600 clamp(20px, 1.8vw, 26px)/1.15 var(--display); }
  .r-blurb { grid-column: 2; margin-top: 4px; font-size: 14px; color: var(--muted); }
  .r-count { grid-column: 2; display: inline-flex; align-items: center; gap: 8px; margin-top: 12px; font-size: 14px; font-weight: 600; }
  .r-count :global(.icon) { transition: translate .35s var(--ease-out); }
  .ranges img { grid-column: 3; grid-row: 1 / 4; width: 96px; height: 96px; object-fit: contain; mix-blend-mode: multiply; transition: translate .5s var(--ease-out), scale .5s var(--ease-out); }
  .r-all a { grid-template-columns: minmax(0, 1fr); align-content: center; background: var(--ink); color: #fff; }
  .r-all .r-name, .r-all .r-blurb, .r-all .r-count { grid-column: 1; }
  .r-all .r-blurb { color: var(--on-blue-muted); }
  .r-all a:hover { background: #26262a; }
  .ranges a:hover { background: var(--ink); color: #fff; }
  .ranges a:hover .r-n, .ranges a:hover .r-blurb { color: var(--on-blue-muted); }
  .ranges a:hover img { translate: 0 -6px; scale: 1.06; mix-blend-mode: normal; }
  .ranges a:hover .r-count :global(.icon) { translate: 4px 0; }

  /* ---------- Photo banner ---------- */
  .banner { position: relative; isolation: isolate; overflow: hidden; background: var(--night); color: #fff; }
  .banner-photo { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; filter: grayscale(1) contrast(1.1); }
  .banner::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(10, 10, 10, .88) 0%, rgba(10, 10, 10, .45) 60%, rgba(10, 10, 10, .2) 100%); }
  .banner-inner { padding-block: clamp(80px, 11vw, 160px); }
  .banner h2 { max-width: 12ch; font-size: clamp(36px, 5.4vw, 80px); }
  .banner p { max-width: 40ch; margin: 20px 0 32px; font-size: clamp(16px, 1.4vw, 19px); color: var(--on-blue-muted); }

  /* ---------- Where we work ---------- */
  .band { background: var(--ice); }
  .band-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto; gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(40px, 5vw, 72px); }
  .band h2 { font-size: clamp(26px, 2.6vw, 36px); }
  address { margin-top: 12px; font-style: normal; font-size: 17px; }
  address span { display: block; }
  dl { display: grid; gap: 16px; margin: 0; }
  dt { font-size: 14px; color: var(--muted); }
  dd { margin: 2px 0 0; font-weight: 600; font-size: 17px; overflow-wrap: anywhere; }
  dd a { text-underline-offset: 4px; }

  @media (max-width: 1000px) {
    .pillars { grid-template-columns: minmax(0, 1fr); }
    .pillar-icon { margin-bottom: 28px; }
    .ranges { grid-template-columns: minmax(0, 1fr); }
    .fact-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fact-row li:nth-child(odd) { padding-left: 0; border-left: 0; }
    .fact-row li:nth-child(n + 3) { border-top: 1px solid rgba(255, 255, 255, .14); }
    .band-grid { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .band .btn { justify-self: start; }
  }
  @media (max-width: 560px) {
    .hero { min-height: 100svh; }
    .hero::after { background: linear-gradient(0deg, rgba(10, 10, 10, .92) 0%, rgba(10, 10, 10, .55) 55%, rgba(10, 10, 10, .35) 100%); }
    .hero-photo { object-position: 70% 20%; }
    .hero-inner { padding-block: 120px 40px; }
    .actions .btn { flex: 1 1 100%; }
    .ranges a { grid-template-columns: 28px minmax(0, 1fr) 72px; padding: 18px 16px; min-height: 0; }
    .ranges img { width: 72px; height: 72px; }
    .banner::after { background: rgba(10, 10, 10, .72); }
    .banner .btn { width: 100%; }
  }
</style>

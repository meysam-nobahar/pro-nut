---
import Base from '../layouts/Base.astro';
import { brand } from '../lib/brand.js';
import { categories, products, pick } from '../lib/catalogue.js';

const packs = pick(['royal-mass', 'eaa', 'gaba']);
---
<Base title="About" current="about" description={`Royal Nutrition: ${brand.tagline}. Based in Pustkow, Poland.`}>
  <section class="wrap intro">
    <div>
      <p class="eyebrow">About Royal Nutrition</p>
      <h1>Built to break limits.</h1>
      <p class="body">Royal Nutrition makes European food supplements for athletes who refuse to stand still. Formulated with the best science in Europe and the world, and trusted by elite athletes and bodybuilders, every product exists to make you stronger and take your limits away.</p>
      <a class="btn" href="/products/">Enter the range</a>
    </div>
    <div class="stage" aria-hidden="true">
      {packs.map((p, i) => <img class={`pack pack-${i + 1}`} src={p.images[0].src} alt="" width="880" height="880" />)}
    </div>
  </section>

  <section class="band on-blue">
    <div class="wrap band-grid">
      <div>
        <h2>Where we work</h2>
        <address>
          {brand.address.map((line) => <span>{line}</span>)}
        </address>
      </div>
      <dl>
        <div><dt>The range</dt><dd>{categories.length} ranges, each built around one goal</dd></div>
        <div><dt>Our focus</dt><dd>{brand.tagline}</dd></div>
      </dl>
      <a class="btn invert" href="/contact/">Contact us</a>
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 72px); align-items: center; padding-block: clamp(32px, 5vw, 72px); }
  h1 { margin-top: 16px; font-size: clamp(32px, 5vw, 68px); font-weight: 700; line-height: 1; }
  .body { margin: 24px 0 32px; max-width: 54ch; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: var(--muted); }

  .stage { position: relative; aspect-ratio: 1 / .92; background: var(--ice); isolation: isolate; }
  .pack { position: absolute; mix-blend-mode: multiply; }
  .pack-1 { width: 66%; left: 17%; bottom: 3%; z-index: 2; }
  .pack-2 { width: 47%; left: -3%; bottom: 3%; }
  .pack-3 { width: 50%; right: -5%; bottom: 3%; }

  .band { background: var(--blue); color: var(--white); }
  .band-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto; gap: clamp(24px, 4vw, 64px); align-items: center; padding-block: clamp(40px, 5vw, 64px); }
  h2 { font-size: clamp(28px, 3vw, 40px); font-weight: 700; }
  address { margin-top: 12px; font-style: normal; font-size: 17px; }
  address span { display: block; }
  dl { display: grid; gap: 16px; margin: 0; }
  dt { font-size: 14px; color: var(--on-blue-muted); }
  dd { margin: 2px 0 0; font-weight: 600; font-size: 17px; }

  @media (max-width: 900px) {
    .intro, .band-grid { grid-template-columns: minmax(0, 1fr); }
    .band-grid { align-items: start; }
    .band .btn { justify-self: start; }
  }
</style>

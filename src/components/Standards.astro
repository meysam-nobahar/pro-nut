---
import Icon from './Icon.astro';
import { standards, seals } from '../lib/standards.js';

// variant "full": the About page section. variant "compact": the strip on the home and product pages.
const { variant = 'full', dark = false } = Astro.props;
const compact = variant === 'compact';
---
<section id={compact ? undefined : 'standards'} class:list={['std', { 'std--compact': compact, 'on-dark': dark }]} aria-labelledby={`std-title-${variant}`}>
  <div class="wrap std-inner">
    <div class="std-head" data-fade>
      <p class="std-kicker">Our standards</p>
      <h2 id={`std-title-${variant}`}>{compact ? 'Made to the Royal standard' : 'Quality you can verify'}</h2>
      {!compact && <p class="std-intro">From the first raw material to the sealed pack, every Royal Nutrition product is made, checked and released under the same standards.</p>}
      <ul class="std-seals" aria-label="Certifications and standards">
        {seals.map((s) => (
          <li>
            <svg viewBox="0 0 96 96" role="img" aria-label={`${s.label} ${s.sub}`}>
              <circle cx="48" cy="48" r="45" fill="none" stroke="currentColor" stroke-width="2" />
              <circle cx="48" cy="48" r="38" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4" />
              <text x="48" y="52" text-anchor="middle" class="seal-main">{s.label}</text>
              <text x="48" y="66" text-anchor="middle" class="seal-sub">{s.sub.split(' ')[0].toUpperCase()}</text>
            </svg>
          </li>
        ))}
      </ul>
      {compact && <a class="std-link" href="/about/#standards">How we make it<Icon name="arrow" /></a>}
    </div>

    <ol class="std-list">
      {standards.map((s, i) => (
        <li data-fade>
          <span class="std-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="std-icon"><Icon name={s.icon} /></span>
          <span class="std-title">{s.title}</span>
          {!compact && <span class="std-text">{s.text}</span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .std { padding-block: clamp(64px, 8vw, 120px); background: var(--white); color: var(--ink); }
  .std.on-dark { background: var(--night); color: #fff; }
  .std--compact { padding-block: clamp(48px, 6vw, 88px); background: var(--ice); }
  .std--compact.on-dark { background: var(--night); }
  .std-inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.5fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .std-head { position: sticky; top: 112px; }
  .std--compact .std-head { position: static; }
  .std-kicker { font: 500 13px/1 var(--display); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .on-dark .std-kicker { color: var(--on-blue-muted); }
  .std-head h2 { margin-top: 16px; font-size: clamp(30px, 3.6vw, 52px); font-weight: 600; }
  .std--compact .std-head h2 { font-size: clamp(26px, 2.8vw, 38px); }
  .std-intro { max-width: 40ch; margin-top: 20px; color: var(--muted); font-size: 17px; }
  .on-dark .std-intro { color: var(--on-blue-muted); }

  .std-seals { display: flex; gap: clamp(12px, 2vw, 20px); margin: 32px 0 0; }
  .std-seals svg { display: block; width: clamp(72px, 7vw, 96px); height: auto; color: currentColor; }
  .std-seals li { transition: translate .5s var(--ease-out), rotate .8s var(--ease-out); }
  .std-seals li:hover { translate: 0 -4px; rotate: 6deg; }
  .seal-main { font: 700 17px/1 var(--display); fill: currentColor; letter-spacing: .02em; }
  .seal-sub { font: 500 7.5px/1 var(--display); fill: currentColor; letter-spacing: .22em; opacity: .75; }
  .std-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; font-weight: 600; text-underline-offset: 6px; text-decoration: underline; text-decoration-thickness: 1.5px; }
  .std-link :global(.icon) { transition: translate .35s var(--ease-out); }
  .std-link:hover :global(.icon) { translate: 4px 0; }

  .std-list { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--line); }
  .on-dark .std-list { border-color: rgb(255 255 255 / .16); }
  .std-list li { display: grid; grid-template-columns: 32px 44px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 16px; align-items: center; padding: 20px 0; border-top: 1px solid var(--line); }
  .on-dark .std-list li { border-color: rgb(255 255 255 / .16); }
  .std-n { grid-row: 1 / 3; align-self: start; padding-top: 12px; font: 500 14px/1 var(--display); color: var(--muted); font-variant-numeric: tabular-nums; }
  .on-dark .std-n { color: var(--on-blue-muted); }
  .std-icon { grid-row: 1 / 3; display: grid; place-items: center; width: 44px; height: 44px; background: var(--ink); color: #fff; border-radius: 50%; }
  .on-dark .std-icon { background: #fff; color: var(--ink); }
  .std-icon :global(.icon) { width: 22px; height: 22px; }
  .std-title { font: 600 clamp(18px, 1.7vw, 24px)/1.2 var(--display); }
  .std-text { margin-top: 4px; font-size: 15px; color: var(--muted); }
  .on-dark .std-text { color: var(--on-blue-muted); }
  .std--compact .std-list li { padding: 14px 0; }
  .std--compact .std-icon { width: 36px; height: 36px; }
  .std--compact .std-icon :global(.icon) { width: 18px; height: 18px; }
  .std--compact .std-title { font-size: clamp(16px, 1.4vw, 19px); }

  @media (max-width: 900px) {
    .std-inner { grid-template-columns: minmax(0, 1fr); }
    .std-head { position: static; }
  }
  @media (max-width: 560px) {
    .std-list li { grid-template-columns: 24px 40px minmax(0, 1fr); column-gap: 12px; }
    .std-icon { width: 40px; height: 40px; }
    .std-seals svg { width: 76px; }
  }
</style>
